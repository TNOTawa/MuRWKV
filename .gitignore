# secrets
.env
*.env
**/credentials*
**/*.pem
**/*.key

# GitHub token helper: environment-specific script; reads the real token from
# /root/.gh_token (outside the repo) and shreds it after use. Keep untracked.
scripts/gh_login_token.sh

# postmortem token-probe outputs (regenerable from the tracked script)
results/r2_postmortem/token_probe.csv
results/r2_postmortem/token_probe_summary.json
# exception: the postmortem analysis script itself (contains no secrets) is tracked
!scripts/r2_postmortem/token_probe.py

# data (large, never commit) — root-anchored so the src/murwkv/data/ package is tracked
/data/
*.tar.gz
*.flac
*.wav
*.mp3
*.mid.bin
babyslakh*/

# checkpoints / outputs
checkpoints/
hf_cache/
wandb/
*.pt
*.pth
*.ckpt
*.safetensors
*.npz

